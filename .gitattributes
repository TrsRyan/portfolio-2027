# Normalizes line endings: LF in the repo AND on checkout,
# regardless of each machine's core.autocrlf setting.
* text=auto eol=lf

# Binary files — never convert line endings.
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.pdf   binary
